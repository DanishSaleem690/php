# Railway → PHP service → Variables (link MySQL plugin to this service)
#
# Option A — reference (recommended; no secrets in git):
#   MYSQL_URL = ${{MySQL.MYSQL_URL}}
#   (Service name "MySQL" must match your MySQL plugin name in Railway.)
#
# Option B — auto-injected when MySQL is linked:
#   MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
#
# Then run sql/railway_contact_submissions.sql on the `railway` database.
# Do NOT commit real passwords or paste MYSQL_URL into GitHub.

# Required for browser calls from Netlify (your live Netlify URL, no trailing slash)
# Any *.netlify.app origin is already allowed; set this for your production URL.
FRONTEND_ORIGIN=https://YOUR-SITE.netlify.app

# Optional extra origins (comma-separated): previews, custom domains
# CORS_ALLOWED_ORIGINS=https://www.example.com

# Public URL of this API (used for uploaded CV links in upload_cv.php)
PUBLIC_API_BASE_URL=https://php-updated-production.up.railway.app

# Email (Brevo) — set on Railway; never commit keys to GitHub
# BREVO_API_KEY=xkeysib-...
# EMAIL_PROVIDER=brevo
# EMAIL_FROM=you@yourdomain.com
# EMAIL_TO=danish.it@klashpvt.com,waseem.it@klashpvt.com
# EMAIL_FROM_LABEL=Website contact

# Local dev only: copy database.example.php → database.php
